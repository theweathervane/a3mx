+        SDL_SetPointerProperty(renderer->props, SDL_PROP_GPU_DEVICE_METAL_COMMAND_QUEUE_POINTER, (__bridge void *)renderer->queue);
+        SDL_SetPointerProperty(renderer->props, SDL_PROP_GPU_DEVICE_NATIVE_COMMAND_BUFFER_FUNCTION_POINTER, (void *)METAL_INTERNAL_NativeCommandBuffer);
+        SDL_SetPointerProperty(renderer->props, SDL_PROP_GPU_DEVICE_NATIVE_TEXTURE_FUNCTION_POINTER, (void *)METAL_INTERNAL_NativeTexture);
+
         // Record device name
         const char *deviceName = [device.name UTF8String];
