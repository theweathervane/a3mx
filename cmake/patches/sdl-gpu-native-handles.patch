--- src/gpu/vulkan/SDL_gpu_vulkan.c
+++ src/gpu/vulkan/SDL_gpu_vulkan.c
@@ -5085,6 +5085,25 @@ static void VULKAN_DestroyDevice(
     SDL_Vulkan_UnloadLibrary();
 }
 
+/* A3MX patch (SDL issue #10876): the native objects, for SDL_PROP_GPU_DEVICE_NATIVE_*_FUNCTION_POINTER */
+static void *SDLCALL VULKAN_INTERNAL_NativeCommandBuffer(SDL_GPUCommandBuffer *commandBuffer)
+{
+    return commandBuffer ? (void *)((VulkanCommandBuffer *)commandBuffer)->commandBuffer : NULL;
+}
+
+static void *SDLCALL VULKAN_INTERNAL_NativeTexture(SDL_GPUTexture *texture, Uint32 *layoutOrState)
+{
+    VulkanTextureContainer *container = (VulkanTextureContainer *)texture;
+    VulkanTexture *vulkanTexture = container ? container->activeTexture : NULL;
+    if (layoutOrState) {
+        VulkanTextureUsageMode mode = vulkanTexture ? VULKAN_INTERNAL_DefaultTextureUsageMode(vulkanTexture) : VULKAN_TEXTURE_USAGE_MODE_SAMPLER;
+        *layoutOrState = (Uint32)(mode == VULKAN_TEXTURE_USAGE_MODE_COLOR_ATTACHMENT ? VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL :
+                                  mode == VULKAN_TEXTURE_USAGE_MODE_SAMPLER || mode == VULKAN_TEXTURE_USAGE_MODE_GRAPHICS_STORAGE_READ ?
+                                  VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL : VK_IMAGE_LAYOUT_GENERAL);
+    }
+    return vulkanTexture ? (void *)vulkanTexture->image : NULL;
+}
+
 static SDL_PropertiesID VULKAN_GetDeviceProperties(
     SDL_GPUDevice *device)
 {
@@ -12910,6 +12929,15 @@ static SDL_GPUDevice *VULKAN_CreateDevice(bool debugMode, bool preferLowPower, S
 
     // FIXME: just move this into this function
     result = (SDL_GPUDevice *)SDL_calloc(1, sizeof(SDL_GPUDevice));
+
+    // A3MX patch (SDL issue #10876): the native objects
+    SDL_SetPointerProperty(renderer->props, SDL_PROP_GPU_DEVICE_VULKAN_INSTANCE_POINTER, (void *)renderer->instance);
+    SDL_SetPointerProperty(renderer->props, SDL_PROP_GPU_DEVICE_VULKAN_PHYSICAL_DEVICE_POINTER, (void *)renderer->physicalDevice);
+    SDL_SetPointerProperty(renderer->props, SDL_PROP_GPU_DEVICE_VULKAN_DEVICE_POINTER, (void *)renderer->logicalDevice);
+    SDL_SetPointerProperty(renderer->props, SDL_PROP_GPU_DEVICE_VULKAN_QUEUE_POINTER, (void *)renderer->unifiedQueue);
+    SDL_SetNumberProperty(renderer->props, SDL_PROP_GPU_DEVICE_VULKAN_QUEUE_FAMILY_INDEX_NUMBER, renderer->queueFamilyIndex);
+    SDL_SetPointerProperty(renderer->props, SDL_PROP_GPU_DEVICE_NATIVE_COMMAND_BUFFER_FUNCTION_POINTER, (void *)VULKAN_INTERNAL_NativeCommandBuffer);
+    SDL_SetPointerProperty(renderer->props, SDL_PROP_GPU_DEVICE_NATIVE_TEXTURE_FUNCTION_POINTER, (void *)VULKAN_INTERNAL_NativeTexture);
     ASSIGN_DRIVER(VULKAN)
 
     result->driverData = (SDL_GPURenderer *)renderer;
